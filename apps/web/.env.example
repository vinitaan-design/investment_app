# Copy to .env.local for local development. Never commit .env.local.
# Supabase project "investkea" (Mumbai). Both values are public by design:
# access is controlled by row-level security in the database.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only secret key (Supabase → Project Settings → API keys → Secret keys).
# Only for admin tasks such as verifying advisors. Set it in your hosting provider,
# never in a NEXT_PUBLIC_ variable and never in the browser.
SUPABASE_SECRET_KEY=
