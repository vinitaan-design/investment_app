{
  "name": "investkea",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @investkea/web",
    "build": "npm run build -w @investkea/web",
    "storybook": "npm run storybook -w @investkea/ui",
    "build-storybook": "npm run build-storybook -w @investkea/ui",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:css": "npm run check:css -w @investkea/web",
    "check:build": "npm run check:css -w @investkea/web && npm run check:private-routes -w @investkea/web"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
